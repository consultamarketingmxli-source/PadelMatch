licados y bloquea si ya hay resultados (409).\n     * Devuelve breakdown: creadas + omitidos[{nombre, razon}].\n     */\n    importInscripciones: (retaId, jugadores) => request(`/retas/${retaId}/inscripciones/import`, {\n      method: \"POST\",\n      body: {\n        jugadores\n      },\n      auth: true\n    }),\n    listResultados: retaId => request(`/retas/${retaId}/resultados`, {\n      auth: true\n    }),\n    upsertResultado: (retaId, body) => request(`/retas/${retaId}/resultados`, {\n      method: \"POST\",\n      body,\n      auth: true\n    }),\n    deleteResultado: (retaId, resultId) => request(`/retas/${retaId}/resultados/${resultId}`, {\n      method: \"DELETE\",\n      auth: true\n    }),\n    tablaPosiciones: retaId => request(`/public/retas/${retaId}/tabla`),\n    /** Clasificación privada — admin (auth:true) o player (header Authorization). */\n    getClasificacionAdmin: retaId => request(`/retas/${retaId}/clasificacion`, {\n      auth: true\n    }),\n    getClasificacionPlayer: (retaId, playerToken) => request(`/retas/${retaId}/clasificacion`, {\n      headers: {\n        Authorization: `Bearer ${playerToken}`\n      }\n    }),\n    /** URL completa del WebSocket realtime. token opcional (admin o player). */\n    getRealtimeWsUrl: (retaId, token) => {\n      const httpBase = (BASE || \"\").replace(/\\/$/, \"\");\n      const wsBase = httpBase.replace(/^http:/, \"ws:\").replace(/^https:/, \"wss:\");\n      const encoded = encodeURIComponent(token);\n      return `${wsBase}/api/ws/retas/${encodeURIComponent(retaId)}?token=${encoded}`;\n    },\n    // ===== stripe checkout =====\n    checkoutStripe: (retaId, body) => request(`/public/retas/${retaId}/checkout-stripe`, {\n      method: \"POST\",\n      body\n    }),\n    paymentStatus: inscripcionId => request(`/public/inscripciones/${inscripcionId}/payment-status`),\n    // ===== mercado pago marketplace =====\n    mpStatus: () => request(`/admin/mercadopago/status`, {\n      auth: true\n    }),\n    mpConnect: access_token => request(`/admin/mercadopago/connect`, {\n      method: \"POST\",\n      body: {\n        access_token\n      },\n      auth: true\n    }),\n    mpDisconnect: () => request(`/admin/mercadopago/disconnect`, {\n      method: \"POST\",\n      auth: true\n    }),\n    mpUpdateSettings: apply_fee => request(`/admin/mercadopago/settings`, {\n      method: \"PATCH\",\n      body: {\n        apply_fee\n      },\n      auth: true\n    }),\n    checkoutMercadoPago: (retaId, body) => request(`/public/retas/${retaId}/checkout-mercadopago`, {\n      method: \"POST\",\n      body\n    }),\n    mpPaymentStatus: inscripcionId => request(`/public/inscripciones/${inscripcionId}/mp-status`),\n    // ===== admin dashboard =====\n    adminMetrics: () => request(`/admin/metrics`, {\n      auth: true\n    }),\n    refundInscripcion: (retaId, inscripcionId) => request(`/admin/retas/${retaId}/inscripciones/${inscripcionId}/refund`, {\n      method: \"POST\",\n      auth: true\n    }),\n    // ===== player auth (OTP) =====\n    playerRequestOtp: body => request(`/players/auth/otp/request`, {\n      method: \"POST\",\n      body\n    }),\n    playerVerifyOtp: body => request(`/players/auth/otp/verify`, {\n      method: \"POST\",\n      body\n    }),\n    playerMe: token => request(`/players/me`, {\n      headers: {\n        Authorization: `Bearer ${token}`\n      }\n    }),\n    playerMyInscripciones: token => request(`/players/me/inscripciones`, {\n      headers: {\n        Authorization: `Bearer ${token}`\n      }\n    }),\n    playerMyStats: token => request(`/players/me/stats`, {\n      headers: {\n        Authorization: `Bearer ${token}`\n      }\n    }),\n    playerMyWaitlist: token => request(`/players/me/waitlist`, {\n      headers: {\n        Authorization: `Bearer ${token}`\n      }\n    }),\n    // ===== pdf =====\n    async generatePdfUrl(retaId, jugadores, numRondas) {\n      // Devuelve un blob URL listo para abrir.\n      const headers = {\n        \"Content-Type\": \"application/json\",\n        ...(await tokenHeader())\n      };\n      const res = await fetch(`${BASE}/api/retas/${retaId}/pdf`, {\n        method: \"POST\",\n        headers,\n        body: JSON.stringify({\n          jugadores,\n          num_rondas: numRondas\n        })\n      });\n      if (!res.ok) throw new Error(`PDF error ${res.status}`);\n      const blob = await res.blob();\n      return URL.createObjectURL(blob);\n    },\n    // ===== exports CSV / PDF clasificación =====\n    async exportRolCsvUrl(retaId) {\n      return _downloadBlob(`/retas/${retaId}/rol/csv`, \"text/csv\");\n    },\n    async exportClasificacionCsvUrl(retaId) {\n      return _downloadBlob(`/retas/${retaId}/clasificacion/csv`, \"text/csv\");\n    },\n    async exportClasificacionPdfUrl(retaId) {\n      return _downloadBlob(`/retas/${retaId}/clasificacion/pdf`, \"application/pdf\");\n    },\n    // ===== Fase 4 — Retas de Parejas (Admin) =====\n    /** Lista jugadores aprobados sin pareja (free-agents). */\n    listFreeAgents: retaId => request(`/retas/${retaId}/free-agents`, {\n      auth: true\n    }),\n    /** Lista todos los dúos con sus miembros (para Mesa de Control / UI). */\n    listDuos: retaId => request(`/retas/${retaId}/duos`, {\n      auth: true\n    }),\n    /** Empareja DOS free-agents en un dúo nuevo. */\n    matchFreeAgents: (retaId, inscripcion_a_id, inscripcion_b_id) => request(`/retas/${retaId}/free-agents/match`, {\n      method: \"POST\",\n      body: {\n        inscripcion_a_id,\n        inscripcion_b_id\n      },\n      auth: true\n    }),\n    /** Cancela inscripción. modo='duo' borra ambos, 'solo' deja al otro como free-agent. */\n    cancelInscripcionPareja: (retaId, insc_id, modo = \"duo\") => request(`/retas/${retaId}/inscripciones/${insc_id}?modo=${modo}`, {\n      method: \"DELETE\",\n      auth: true\n    }),\n    // ===== Notificaciones admin (Twilio WhatsApp) =====\n    /** Manda recordatorio \"2h antes\" a todos los inscritos Aprobado