EN_KEY, r.access_token);\n      return r;\n    },\n    async logout() {\n      await _srcUtilsStorage.storage.secureRemove(TOKEN_KEY);\n    },\n    async getToken() {\n      return (await _srcUtilsStorage.storage.secureGet(TOKEN_KEY, \"\")) || null;\n    },\n    async me() {\n      return request(\"/auth/me\", {\n        auth: true\n      });\n    },\n    // ===== retas admin =====\n    listRetasAdmin: () => request(\"/retas\", {\n      auth: true\n    }),\n    getRetaAdmin: id => request(`/retas/${id}`, {\n      auth: true\n    }),\n    createReta: body => request(\"/retas\", {\n      method: \"POST\",\n      body,\n      auth: true\n    }),\n    updateReta: (id, body) => request(`/retas/${id}`, {\n      method: \"PUT\",\n      body,\n      auth: true\n    }),\n    deleteReta: id => request(`/retas/${id}`, {\n      method: \"DELETE\",\n      auth: true\n    }),\n    listInscripciones: id => request(`/retas/${id}/inscripciones`, {\n      auth: true\n    }),\n    // ===== Compartir (Fase B) =====\n    getShareInfo: id => request(`/retas/${id}/share-info`, {\n      auth: true\n    }),\n    /** URL absoluta del PNG QR público (no requiere auth) — sirve como src de <Image>. */\n    getPublicQrUrl: slug => `${BASE}/api/public/retas/${slug}/qr`,\n    // ===== retas público =====\n    radar: (lat, lng, radioKm = 30) => {\n      const qs = lat !== undefined && lng !== undefined ? `?lat=${lat}&lng=${lng}&radio_km=${radioKm}` : \"\";\n      return request(`/public/retas/radar${qs}`);\n    },\n    /**\n     * Motor de búsqueda híbrido — 3 vías combinables:\n     *  A) GPS (lat/lng + radioKm)\n     *  B) Texto (q, trim+lowercase aplicado en server)\n     *  C) Fallback: sin params → todas ordenadas por fecha_evento ASC.\n     */\n    buscarRetas: params => {\n      const sp = new URLSearchParams();\n      const q = (params.q ?? \"\").trim().toLowerCase();\n      if (q) sp.set(\"q\", q);\n      if (params.lat !== undefined && params.lng !== undefined) {\n        sp.set(\"lat\", 