 resultId) => request(`/retas/${retaId}/resultados/${resultId}`, {\n      method: \"DELETE\",\n      auth: true\n    }),\n    tablaPosiciones: retaId => request(`/public/retas/${retaId}/tabla`),\n    /** Clasificación privada — admin (auth:true) o player (header Authorization). */\n    getClasificacionAdmin: retaId => request(`/retas/${retaId}/clasificacion`, {\n      auth: true\n    }),\n    getClasificacionPlayer: (retaId, playerToken) => request(`/retas/${retaId}/clasificacion`, {\n      headers: {\n        Authorization: `Bearer ${playerToken}`\n      }\n    }),\n    /** URL completa del WebSocket realtime. token opcional (admin o player). */\n    getRealtimeWsUrl: (retaId, token) => {\n      const httpBase = (BASE || \"\").replace(/\\/$/, \"\");\n      const wsBase = httpBase.replace(/^http:/, \"ws:\").replace(/^https:/, \"wss:\");\n      const encoded = encodeURIComponent(token);\n      return `${wsBase}/api/ws/retas/${encodeURIComponent(retaId)}?token=${encoded}`;\n    },\n    // ===== stripe checkout =====\n    checkoutStripe: (retaId, body) => request(`/public/retas/${retaId}/checkout-stripe`, {\n      method: \"POST\",\n      body\n    }),\n    paymentStatus: inscripcionId => request(`/public/inscripciones/${inscripcionId}/payment-status`),\n    // ===== mercado pago marketplace =====\n    mpStatus: () => request(`/admin/mercadopago/status`, {\n      auth: true\n    }),\n    mpConnect: access_token => request(`/admin/mercadopago/connect`, {\n      method: \"POST\",\n      body: {\n        access_token\n      },\n      auth: true\n    }),\n    mpDisconnect: () => request(`/admin/mercadopago/disconnect`, {\n      method: \"POST\",\n      auth: true\n    }),\n    mpUpdateSettings: apply_fee => request(`/admin/mercadopago/settings`, {\n      method: \"PATCH\",\n      body: {\n        apply_fee\n      },\n      auth: true\n    }),\n    /** Fase Marketplace: inicia el flujo OAuth y devuelve la URL para abrir en el navegador. */\n    mpOAuthStart: redirect_uri =>