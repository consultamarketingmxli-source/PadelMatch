{"dependencies":[{"name":"expo/virtual/env","data":{"asyncType":null,"isESMImport":false,"locs":[],"key":"dgHc21cgR+buKc7O3/dChhD5JJk=","exportNames":["*"],"imports":1}},{"name":"@/src/utils/storage","data":{"asyncType":null,"isESMImport":true,"locs":[{"start":{"line":2,"column":0,"index":75},"end":{"line":2,"column":46,"index":121}}],"key":"HEN+LHqnX5TTSvCXqowEYEgv4zQ=","exportNames":["*"],"imports":1}}],"output":[{"data":{"code":"__d(function (global, require, _$$_IMPORT_DEFAULT, _$$_IMPORT_ALL, module, exports, _dependencyMap) {\n  \"use strict\";\n\n  Object.defineProperty(exports, '__esModule', {\n    value: true\n  });\n  Object.defineProperty(exports, \"api\", {\n    enumerable: true,\n    get: function () {\n      return api;\n    }\n  });\n  var _expoVirtualEnv = require(_dependencyMap[0], \"expo/virtual/env\");\n  var _srcUtilsStorage = require(_dependencyMap[1], \"@/src/utils/storage\");\n  /** API client for PadelappRetas OS — handles auth token + /api prefix. */\n\n  const BASE = _expoVirtualEnv.env.EXPO_PUBLIC_BACKEND_URL ?? \"\";\n  const TOKEN_KEY = \"ppos.admin.token\";\n\n  /** Directorio de Clubes (Selector Inteligente). */\n\n  // ===== Marketing — Cupones =====\n\n  async function tokenHeader() {\n    const t = await _srcUtilsStorage.storage.secureGet(TOKEN_KEY, \"\");\n    return t ? {\n      Authorization: `Bearer ${t}`\n    } : {};\n  }\n  async function request(path, opts = {}) {\n    const headers = {\n      \"Content-Type\": \"application/json\"\n    };\n    if (opts.auth) Object.assign(headers, await tokenHeader());\n    if (opts.headers) Object.assign(headers, opts.headers);\n    const res = await fetch(`${BASE}/api${path}`, {\n      method: opts.method ?? \"GET\",\n      headers,\n      body: opts.body !== undefined ? JSON.stringify(opts.body) : undefined\n    });\n    if (!res.ok) {\n      const txt = await res.text();\n      throw new Error(`${res.status}: ${txt}`);\n    }\n    if (opts.raw) return res;\n    return await res.json();\n  }\n  const api = {\n    // ===== auth =====\n    async login(username, password) {\n      const r = await request(\"/auth/login\", {\n        method: \"POST\",\n        body: {\n          username,\n          password\n        }\n      });\n      await _srcUtilsStorage.storage.secureSet(TOKEN_KEY, r.access_token);\n      return r;\n    },\n    async logout() {\n      await _srcUtilsStorage.storage.secureRemove(TOKEN_KEY);\n    },\n    async getToken() {\n      return (await _srcUtilsStorage.storage.secureGet(TOKEN_KEY, \"\")) || null;\n    },\n    async me() {\n      return request(\"/auth/me\", {\n        auth: true\n      });\n    },\n    // ===== retas admin =====\n    listRetasAdmin: () => request(\"/retas\", {\n      auth: true\n    }),\n    getRetaAdmin: id => request(`/retas/${id}`, {\n      auth: true\n    }),\n    createReta: body => request(\"/retas\", {\n      method: \"POST\",\n      body,\n      auth: true\n    }),\n    updateReta: (id, body) => request(`/retas/${id}`, {\n      method: \"PUT\",\n      body,\n      auth: true\n    }),\n    deleteReta: id => request(`/retas/${id}`, {\n      method: \"DELETE\",\n      auth: true\n    }),\n    listInscripciones: id => request(`/retas/${id}/inscripciones`, {\n      auth: true\n    }),\n    // ===== Compartir (Fase B) =====\n    getShareInfo: id => request(`/retas/${id}/share-info`, {\n      auth: true\n    }),\n    /** URL absoluta del PNG QR público (no requiere auth) — sirve como src de <Image>. */\n    getPublicQrUrl: slug => `${BASE}/api/public/retas/${slug}/qr`,\n    // ===== retas público =====\n    radar: (lat, lng, radioKm = 30) => {\n      const qs = lat !== undefined && lng !== undefined ? `?lat=${lat}&lng=${lng}&radio_km=${radioKm}` : \"\";\n      return request(`/public/retas/radar${qs}`);\n    },\n    /**\n     * Motor de búsqueda híbrido — 3 vías combinables:\n     *  A) GPS (lat/lng + radioKm)\n     *  B) Texto (q, trim+lowercase aplicado en server)\n     *  C) Fallback: sin params → todas ordenadas por fecha_evento ASC.\n     */\n    buscarRetas: params => {\n      const sp = new URLSearchParams();\n      const q = (params.q ?? \"\").trim().toLowerCase();\n      if (q) sp.set(\"q\", q);\n      if (params.lat !== undefined && params.lng !== undefined) {\n        sp.set(\"lat\", String(params.lat));\n        sp.set(\"lng\", String(params.lng));\n        sp.set(\"radio_km\", String(params.radioKm ?? 30));\n      }\n      const qs = sp.toString() ? `?${sp.toString()}` : \"\";\n      return request(`/public/retas/buscar${qs}`);\n    },\n    getRetaBySlug: slug => request(`/public/retas/${slug}`),\n    // ===== Directorio de Clubes (Selector Inteligente) =====\n    buscarClubes: params => {\n      const sp = new URLSearchParams();\n      const q = (params.q ?? \"\").trim();\n      if (q) sp.set(\"q\", q);\n      if (params.lat !== undefined && params.lng !== undefined) {\n        sp.set(\"lat\", String(params.lat));\n        sp.set(\"lng\", String(params.lng));\n        sp.set(\"radio_km\", String(params.radioKm ?? 50));\n      }\n      if (params.limit) sp.set(\"limit\", String(params.limit));\n      const qs = sp.toString() ? `?${sp.toString()}` : \"\";\n      return request(`/public/clubes/buscar${qs}`);\n    },\n    // ===== inscripciones =====\n    checkout: (retaId, body) => request(`/public/retas/${retaId}/checkout`, {\n      method: \"POST\",\n      body\n    }),\n    joinWaitlist: (retaId, body) => request(`/public/retas/${retaId}/waitlist`, {\n      method: \"POST\",\n      body\n    }),\n    paymentWebhook: (inscripcionId, status) => request(`/webhooks/payment`, {\n      method: \"POST\",\n      body: {\n        inscripcion_id: inscripcionId,\n        status\n      }\n    }),\n    // ===== stats =====\n    playerStats: telefono => request(`/public/players/${encodeURIComponent(telefono)}/stats`),\n    // ===== resultados =====\n    getRol: retaId => request(`/retas/${retaId}/rol`, {\n      auth: true\n    }),\n    /**\n     * Persiste el orden manual de jugadores (drag & drop entre canchas).\n     * Body: lista ordenada de nombres — debe coincidir 1:1 con inscritos aprobados.\n     * Reglas: 409 si ya existen resultados capturados; 422 si nombres no coinciden.\n     */\n    updateJugadoresOrden: (retaId, jugadores) => request(`/retas/${retaId}/jugadores/orden`, {\n      method: \"PUT\",\n      body: {\n        jugadores\n      },\n      auth: true\n    }),\n    /**\n     * Preview del rol Round Robin con un orden tentativo de jugadores.\n     * No persiste nada — solo simula. Usado en UX de drag & drop para\n     * que el organizador vea cómo quedará la distribución de partidos.\n     */\n    previewRol: (retaId, jugadores) => request(`/retas/${retaId}/rol/preview`, {\n      method: \"POST\",\n      body: {\n        jugadores\n      },\n      auth: true\n    }),\n    /**\n     * Importación masiva de jugadores (CSV). El backend valida cupo,\n     * duplicados y bloquea si ya hay resultados (409).\n     * Devuelve breakdown: creadas + omitidos[{nombre, razon}].\n     */\n    importInscripciones: (retaId, jugadores) => request(`/retas/${retaId}/inscripciones/import`, {\n      method: \"POST\",\n      body: {\n        jugadores\n      },\n      auth: true\n    }),\n    listResultados: retaId => request(`/retas/${retaId}/resultados`, {\n      auth: true\n    }),\n    upsertResultado: (retaId, body) => request(`/retas/${retaId}/resultados`, {\n      method: \"POST\",\n      body,\n      auth: true\n    }),\n    deleteResultado: (retaId, resultId) => request(`/retas/${retaId}/resultados/${resultId}`, {\n      method: \"DELETE\",\n      auth: true\n    }),\n    tablaPosiciones: retaId => request(`/public/retas/${retaId}/tabla`),\n    /** Clasificación privada — admin (auth:true) o player (header Authorization). */\n    getClasificacionAdmin: retaId => request(`/retas/${retaId}/clasificacion`, {\n      auth: true\n    }),\n    getClasificacionPlayer: (retaId, playerToken) => request(`/retas/${retaId}/clasificacion`, {\n      headers: {\n        Authorization: `Bearer ${playerToken}`\n      }\n    }),\n    /** URL completa del WebSocket realtime. token opcional (admin o player). */\n    getRealtimeWsUrl: (retaId, token) => {\n      const httpBase = (BASE || \"\").replace(/\\/$/, \"\");\n      const wsBase = httpBase.replace(/^http:/, \"ws:\").replace(/^https:/, \"wss:\");\n      const encoded = encodeURIComponent(token);\n      return `${wsBase}/api/ws/retas/${encodeURIComponent(retaId)}?token=${encoded}`;\n    },\n    // ===== stripe checkout =====\n    checkoutStripe: (retaId, body) => request(`/public/retas/${retaId}/checkout-stripe`, {\n      method: \"POST\",\n      body\n    }),\n    paymentStatus: inscripcionId => request(`/public/inscripciones/${inscripcionId}/payment-status`),\n    // ===== mercado pago marketplace =====\n    mpStatus: () => request(`/admin/mercadopago/status`, {\n      auth: true\n    }),\n    mpConnect: access_token => request(`/admin/mercadopago/connect`, {\n      method: \"POST\",\n      body: {\n        access_token\n      },\n      auth: true\n    }),\n    mpDisconnect: () => request(`/admin/mercadopago/disconnect`, {\n      method: \"POST\",\n      auth: true\n    }),\n    mpUpdateSettings: apply_fee => request(`/admin/mercadopago/settings`, {\n      method: \"PATCH\",\n      body: {\n        apply_fee\n      },\n      auth: true\n    }),\n    checkoutMercadoPago: (retaId, body) => request(`/public/retas/${retaId}/checkout-mercadopago`, {\n      method: \"POST\",\n      body\n    }),\n    mpPaymentStatus: inscripcionId => request(`/public/inscripciones/${inscripcionId}/mp-status`),\n    // ===== admin dashboard =====\n    adminMetrics: () => request(`/admin/metrics`, {\n      auth: true\n    }),\n    refundInscripcion: (retaId, inscripcionId) => request(`/admin/retas/${retaId}/inscripciones/${inscripcionId}/refund`, {\n      method: \"POST\",\n      auth: true\n    }),\n    // ===== player auth (OTP) =====\n    playerRequestOtp: body => request(`/players/auth/otp/request`, {\n      method: \"POST\",\n      body\n    }),\n    playerVerifyOtp: body => request(`/players/auth/otp/verify`, {\n      method: \"POST\",\n      body\n    }),\n    playerMe: token => request(`/players/me`, {\n      headers: {\n        Authorization: `Bearer ${token}`\n      }\n    }),\n    playerMyInscripciones: token => request(`/players/me/inscripciones`, {\n      headers: {\n        Authorization: `Bearer ${token}`\n      }\n    }),\n    playerMyStats: token => request(`/players/me/stats`, {\n      headers: {\n        Authorization: `Bearer ${token}`\n      }\n    }),\n    playerMyWaitlist: token => request(`/players/me/waitlist`, {\n      headers: {\n        Authorization: `Bearer ${token}`\n      }\n    }),\n    // ===== pdf =====\n    async generatePdfUrl(retaId, jugadores, numRondas) {\n      // Devuelve un blob URL listo para abrir.\n      const headers = {\n        \"Content-Type\": \"application/json\",\n        ...(await tokenHeader())\n      };\n      const res = await fetch(`${BASE}/api/retas/${retaId}/pdf`, {\n        method: \"POST\",\n        headers,\n        body: JSON.stringify({\n          jugadores,\n          num_rondas: numRondas\n        })\n      });\n      if (!res.ok) throw new Error(`PDF error ${res.status}`);\n      const blob = await res.blob();\n      return URL.createObjectURL(blob);\n    },\n    // ===== exports CSV / PDF clasificación =====\n    async exportRolCsvUrl(retaId) {\n      return _downloadBlob(`/retas/${retaId}/rol/csv`, \"text/csv\");\n    },\n    async exportClasificacionCsvUrl(retaId) {\n      return _downloadBlob(`/retas/${retaId}/clasificacion/csv`, \"text/csv\");\n    },\n    async exportClasificacionPdfUrl(retaId) {\n      return _downloadBlob(`/retas/${retaId}/clasificacion/pdf`, \"application/pdf\");\n    },\n    // ===== Fase 4 — Retas de Parejas (Admin) =====\n    /** Lista jugadores aprobados sin pareja (free-agents). */\n    listFreeAgents: retaId => request(`/retas/${retaId}/free-agents`, {\n      auth: true\n    }),\n    /** Lista todos los dúos con sus miembros (para Mesa de Control / UI). */\n    listDuos: retaId => request(`/retas/${retaId}/duos`, {\n      auth: true\n    }),\n    /** Empareja DOS free-agents en un dúo nuevo. */\n    matchFreeAgents: (retaId, inscripcion_a_id, inscripcion_b_id) => request(`/retas/${retaId}/free-agents/match`, {\n      method: \"POST\",\n      body: {\n        inscripcion_a_id,\n        inscripcion_b_id\n      },\n      auth: true\n    }),\n    /** Cancela inscripción. modo='duo' borra ambos, 'solo' deja al otro como free-agent. */\n    cancelInscripcionPareja: (retaId, insc_id, modo = \"duo\") => request(`/retas/${retaId}/inscripciones/${insc_id}?modo=${modo}`, {\n      method: \"DELETE\",\n      auth: true\n    }),\n    // ===== Notificaciones admin (Twilio WhatsApp) =====\n    /** Manda recordatorio \"2h antes\" a todos los inscritos Aprobados. */\n    notifyRecordatorioGeneral: retaId => request(`/retas/${retaId}/notify/recordatorio-general`, {\n      method: \"POST\",\n      auth: true\n    }),\n    /** Manda aviso \"te toca AHORA\" a los jugadores de una ronda concreta. */\n    notifyProximoPartido: (retaId, ronda, cancha) => {\n      const qs = `ronda=${ronda}${cancha != null ? `&cancha=${cancha}` : \"\"}`;\n      return request(`/retas/${retaId}/notify/proximo-partido?${qs}`, {\n        method: \"POST\",\n        auth: true\n      });\n    },\n    /** Manda link público a TODOS los que están en lista de espera. */\n    notifyListaEspera: retaId => request(`/retas/${retaId}/notify/lista-espera`, {\n      method: \"POST\",\n      auth: true\n    }),\n    /** Devuelve info del Sandbox Twilio (instrucciones de \"join\" para destinatarios). */\n    getTwilioSandboxInfo: () => request(\"/admin/twilio/sandbox-info\", {\n      auth: true\n    }),\n    // ===== MARKETING — Cupones de descuento =====\n    /** Crea un cupón. Si `codigo` se omite, genera uno automático tipo PRO-X9K2A7. */\n    crearCupon: body => request(\"/admin/cupones\", {\n      method: \"POST\",\n      body,\n      auth: true\n    }),\n    /** Lista cupones del organizador (filtros opc.). */\n    listarCupones: params => {\n      const qs = new URLSearchParams();\n      if (params?.reta_id) qs.set(\"reta_id\", params.reta_id);\n      if (params?.solo_disponibles) qs.set(\"solo_disponibles\", \"true\");\n      const url = `/admin/cupones${qs.toString() ? `?${qs.toString()}` : \"\"}`;\n      return request(url, {\n        auth: true\n      });\n    },\n    borrarCupon: cuponId => request(`/admin/cupones/${cuponId}`, {\n      method: \"DELETE\",\n      auth: true\n    }),\n    reactivarCupon: cuponId => request(`/admin/cupones/${cuponId}/reactivar`, {\n      method: \"POST\",\n      auth: true\n    }),\n    /** Pre-validación del cupón antes del canje (no consume). PÚBLICO. */\n    validarCupon: (retaId, codigo) => request(`/public/retas/${retaId}/cupon/validar`, {\n      method: \"POST\",\n      body: {\n        codigo\n      }\n    }),\n    /** Canje ATÓMICO. PÚBLICO. Crea inscripción Aprobada al instante. */\n    canjearCupon: (retaId, body) => request(`/public/retas/${retaId}/cupon/canjear`, {\n      method: \"POST\",\n      body\n    }),\n    /** Cancela inscripción INDIVIDUAL (reactiva cupón si aplica). Admin auth. */\n    cancelarInscripcionCuponAware: inscId => request(`/admin/inscripciones/${inscId}/cancelar`, {\n      method: \"DELETE\",\n      auth: true\n    }),\n    // ===== Deploy readiness (LIVE checklist) =====\n    /** Verifica el estado de las credenciales productivas antes de publicar. */\n    getDeployReadiness: () => request(\"/admin/deploy-readiness\", {\n      auth: true\n    }),\n    // ===== RSVP — Retas Gratis / Entre Amigos =====\n    rsvpAceptar: (retaId, body) => request(`/public/retas/${retaId}/rsvp/aceptar`, {\n      method: \"POST\",\n      body\n    }),\n    rsvpRechazar: (retaId, body) => request(`/public/retas/${retaId}/rsvp/rechazar`, {\n      method: \"POST\",\