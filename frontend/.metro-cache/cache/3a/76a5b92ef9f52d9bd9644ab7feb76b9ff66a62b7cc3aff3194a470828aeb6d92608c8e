ue\n    })\n  };\n\n  /**\n   * Helper privado: descarga un blob autenticado y devuelve un blob URL listo\n   * para abrir/descargar desde el browser.\n   */\n  async function _downloadBlob(path, expectedMime) {\n    const headers = {};\n    Object.assign(headers, await tokenHeader());\n    const res = await fetch(`${BASE}/api${path}`, {\n      method: \"GET\",\n      headers\n    });\n    if (!res.ok) {\n      let detail = \"\";\n      try {\n        detail = (await res.text()).slice(0, 200);\n      } catch {\n        /* noop */\n      }\n      throw new Error(`Descarga error ${res.status}: ${detail}`);\n    }\n    const blob = await res.blob();\n    // Forzar el MIME esperado si el browser lo perdió\n    const typedBlob = blob.type ? blob : new Blob([blob], {\n      type: expectedMime\n    });\n    return URL.createObjectURL(typedBlob);\n  }\n});","lineCount":907,"map":[[12,2,26,0,"exports"],[12,9,26,0],[12,10,26,0,"onAuthExpired"],[12,23,26,0],[12,26,26,0,"onAuthExpired"],[12,39,26,0],[13,2,374,0,"exports"],[13,9,374,0],[13,10,374,0,"getAdminAccessToken"],[13,29,374,0],[13,32,374,0,"getAdminAccessToken"],[13,51,374,0],[14,2,379,0,"exports"],[14,9,379,0],[14,10,379,0,"backendBaseUrl"],[14,24,379,0],[14,27,379,0,"backendBaseUrl"],[14,41,379,0],[15,2,396,0,"exports"],[15,9,396,0],[15,10,396,0,"getRefreshToken"],[15,25,396,0],[15,28,396,0,"getRefreshToken"],[15,43,396,0],[16,2,401,0,"exports"],[16,9,401,0],[16,10,401,0,"setRefreshToken"],[16,25,401,0],[16,28,401,0,"setRefreshToken"],[16,43,401,0],[17,2,511,0,"Object"],[17,8,511,0],[17,9,511,0,"defineProperty"],[17,23,511,0],[17,24,511,0,"exports"],[17,31,511,0],[18,4,511,0,"enumerable"],[18,14,511,0],[19,4,511,0,"get"],[19,7,511,0],[19,18,511,0,"get"],[19,19,511,0],[20,6,511,0],[20,13,511,0,"api"],[20,16,511,0],[21,4,511,0],[22,2,511,0],[23,2,1431,2],[23,6,1431,2,"_expoVirtualEnv"],[23,21,1431,2],[23,24,1431,2,"require"],[23,31,1431,2],[23,32,1431,2,"_dependencyMap"],[23,46,1431,2],[24,2,1431,2],[24,6,1431,2,"_reactN