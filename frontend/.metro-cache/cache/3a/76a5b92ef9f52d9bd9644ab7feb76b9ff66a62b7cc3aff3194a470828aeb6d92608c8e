     */\n    playerDeleteMyAccount: async token => {\n      const res = await request(`/players/me`, {\n        method: \"DELETE\",\n        headers: {\n          Authorization: `Bearer ${token}`\n        }\n      });\n      // Limpieza local total tras éxito.\n      await _srcUtilsStorage.storage.secureRemove(TOKEN_KEY);\n      await setRefreshToken(null);\n      try {\n        await _srcUtilsPlayerTokenStore.playerTokenStore.remove();\n      } catch {\n        /* no-op */\n      }\n      return res;\n    },\n    /** Player logout — revoca refresh token + limpia almacenamiento. */\n    async playerLogout() {\n      try {\n        const headers = {\n          \"Content-Type\": \"application/json\",\n          \"X-Client-Platform\": CLIENT_PLATFORM\n        };\n        const init = {\n          method: \"POST\",\n          headers\n        };\n        if (IS_WEB) {\n          init.credentials = \"include\";\n        } else {\n          const ref = await getRefreshToken();\n          if (ref) headers[\"X-Refresh-Token\"] = ref;\n        }\n        await fetch(`${BASE}/api/auth/logout`, init);\n      } catch {\n        /* no-op */\n      }\n      await setRefreshToken(null);\n      try {\n        await _srcUtilsPlayerTokenStore.playerTokenStore.remove();\n      } catch {\n        /* no-op */\n      }\n    },\n    // ===== Centro de Privacidad (Player) =====\n    // Ola E.2 — Estas APIs usan el refresh token para detectar `is_current`.\n    // En web la cookie HttpOnly se envía sola (path=/api, credentials:include).\n    // En native añadimos el header X-Refresh-Token desde SecureStore.\n    playerMySessions: async token => {\n      const headers = {\n        Authorization: `Bearer ${token}`\n      };\n      if (!IS_WEB) {\n        const ref = await getRefreshToken();\n        if (ref) headers[\"X-Refresh-Token\"] = ref;\n      }\n      return request(`/players/me/sessions`, {\n        headers\n      });\n    },\n    playerRevokeSession: async (token, sessionId) => {\n      const headers = {\n        Authorization: `Bearer ${token}`\n      };\n      if (!IS_WEB) {\n        const ref = await getRefreshToken();\n        if (ref) headers[\"X-Refresh-Token\"] = ref;\n      }\n      return request(`/players/me/sessions/${sessionId}`, {\n        method: \"DELETE\",\n        headers\n      });\n    },\n    playerSecurityActivity: async (token, limit = 20) => {\n      const headers = {\n        Authorization: `Bearer ${token}`\n      };\n      if (!IS_WEB) {\n        const ref = await getRefreshToken();\n        if (ref) headers[\"X-Refresh-Token\"] = ref;\n      }\n      return request(`/players/me/security-activity?limit=${limit}`, {\n        headers\n      });\n    },\n    // ===== Centro de Seguridad (Admin) =====\n    adminSecurityStats: (days = 7) => request(`/admin/security/stats?days=${days}`, {\n      auth: true\n    }),\n    adminSecurityLogs: (params = {}) => {\n      const qs = new URLSearchParams();\n      Object.entries(params).forEach(([k, v]) => {\n        if (v !== undefined && v !== null && v !== \"\") qs.set(k, String(v));\n      });\n      return request(`/admin/security/logs?${qs.toString()}`, {\n        auth: true\n      });\n    },\n    /**\n     * Devuelve la URL absoluta del endpoint CSV con los filtros aplicados.\n     * El header Authorization lo añade quien la consuma (fetch + Blob en\n     * web, FileSystem.downloadAsync con header en native).\n     */\n    adminSecurityLogsCsvPath: (params = {}) => {\n      const qs = new URLSearchParams();\n      Object.entries(params).forEach(([k, v]) => {\n        if (v !== undefined && v !== null && v !== \"\") qs.set(k, String(v));\n      });\n      const tail = qs.toString();\n      return `/admin/security/logs.csv${tail ? `?${tail}` : \"\"}`;\n    },\n    // ===== pdf =====\n    async generatePdfUrl(retaId, jugadores, numRondas) {\n      // Devuelve un blob URL listo para abrir.\n      const headers = Object.assign({\n        \"Content-Type\": \"application/json\"\n   