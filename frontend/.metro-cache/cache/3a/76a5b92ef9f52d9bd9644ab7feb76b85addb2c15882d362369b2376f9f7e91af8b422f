();\n        if (ref) headers[\"X-Refresh-Token\"] = ref;\n      }\n      return request(`/players/me/sessions`, {\n        headers\n      });\n    },\n    playerRevokeSession: async (token, sessionId) => {\n      const headers = {\n        Authorization: `Bearer ${token}`\n      };\n      if (!IS_WEB) {\n        const ref = await getRefreshToken();\n        if (ref) headers[\"X-Refresh-Token\"] = ref;\n      }\n      return request(`/players/me/sessions/${sessionId}`, {\n        method: \"DELETE\",\n        headers\n      });\n    },\n    playerSecurityActivity: async (token, limit = 20) => {\n      const headers = {\n        Authorization: `Bearer ${token}`\n      };\n      if (!IS_WEB) {\n        const ref = await getRefreshToken();\n        if (ref) headers[\"X-Refresh-Token\"] = ref;\n      }\n      return request(`/players/me/security-activity?limit=${limit}`, {\n        headers\n      });\n    },\n    // ===== Centro de Seguridad (Admin) =====\n    adminSecurityStats: (days = 7) => request(`/admin/security/stats?days=${days}`, {\n      auth: true\n    }),\n    adminSecurityLogs: (params = {}) => {\n      const qs = new URLSearchParams();\n      Object.entries(params).forEach(([k, v]) => {\n        if (v !== undefined && v !== null && v !== \"\") qs.set(k, String(v));\n      });\n      return request(`/admin/security/logs?${qs.toString()}`, {\n        auth: true\n      });\n    },\n    /**\n     * Devuelve la URL absoluta del endpoint CSV con los filtros aplicados.\n     * El header Authorization lo añade quien la consuma (fetch + Blob en\n     * web, FileSystem.downloadAsync con header en native).\n     */\n    adminSecurityLogsCsvPath: (params = {}) => {\n      const qs = new URLSearchParams();\n      Object.entries(params).forEach(([k, v]) => {\n        if (v !== undefined && v !== null && v !== \"\") qs.set(k, String(v));\n      });\n      const tail = qs.toString();\n      return `/admin/security/logs.csv${tail ? `?${tail}` : \"\"}`;\n    },\n    // ===== pdf =====\n    async generatePdfUrl(retaId, jugadores, numRondas) {\n      // Devuelve un blob URL listo para abrir.\n      const headers = Object.assign({\n        \"Content-Type\": \"application/json\"\n      }, await tokenHeader());\n      const res = await fetch(`${BASE}/api/retas/${retaId}/pdf`, {\n        method: \"POST\",\n        headers,\n        body: JSON.stringify({\n          jugadores,\n          num_rondas: numRondas\n        })\n      });\n      if (!res.ok) throw new Error(`PDF error ${res.status}`);\n      const blob = await res.blob();\n      return URL.createObjectURL(blob);\n    },\n    // ===== exports CSV / PDF clasificación =====\n    async exportRolCsvUrl(retaId) {\n      return _downloadBlob(`/retas/${retaId}/rol/csv`, \"text/csv\");\n    },\n    async exportClasificacionCsvUrl(retaId) {\n      return _downloadBlob(`/retas/${retaId}/clasificacion/csv`, \"text/csv\");\n    },\n    async exportClasificacionPdfUrl(retaId) {\n      return _downloadBlob(`/retas/${retaId}/clasificacion/pdf`, \"application/pdf\");\n    },\n    // ===== Fase 4 — Retas de Parejas (Admin) =====\n    /** Lista jugadores aprobados sin pareja (free-agents). */\n    listFreeAgents: retaId => request(`/retas/${retaId}/free-agents`, {\n      auth: true\n    }),\n    /** Lista todos los dúos con sus miembros (para Mesa de Control / UI). */\n    listDuos: retaId => request(`/retas/${retaId}/duos`, {\n      auth: true\n    }),\n    /** Empareja DOS free-agents en un dúo nuevo. */\n    matchFreeAgents: (retaId, inscripcion_a_id, inscripcion_b_id) => request(`/retas/${retaId}/free-agents/match`, {\n      method: \"POST\",\n      body: {\n        inscripcion_a_id,\n        inscripcion_b_id\n      },\n      auth: true\n    }),\n    /** Cancela inscripción. modo='duo' borra ambos, 'solo' deja al otro como free-agent. */\n    cancelInscripcionPareja: (retaId, insc_id, modo = \"duo\") => request(`/retas/${retaId}/inscripciones/${insc_id}?modo=${modo}`, {\n      method: \"DELETE\",\n      auth: true\n    }),\n    // ===== Notificaciones admin (Twilio WhatsApp) =====\n    /** Manda recordatorio \"2h antes\" a todos los inscritos Aprobados. */\n    notifyRecordatorioGeneral: retaId => request(`/retas/${retaId}/notify/recordatorio-general`, {\n      method: \"POST\",\n      auth: true\n    }),\n    /** Manda aviso \"te toca AHORA\" a los jugadores de una ronda concreta. */\n    notifyProximoPartido: (retaId, ronda, cancha) => {\n      const qs = `ronda=${ronda}${cancha != null ? `&cancha=${cancha}` : \"\"}`;\n      return request(`/retas/${retaId}/notify/proximo-partido?${qs}`, {\n        method: \"POST\",\n        auth: true\n      });\n    },\n    /** Manda link público a TODOS los que están en lista de espera. */\n    notifyListaEspera: retaId => request(`/retas/${retaId}/notify/lista-espera`, {\n      method: \"POST\",\n      auth: true\n    }),\n    /** Devuelve info del Sandbox Twilio (instrucciones de \"join\" para destinatarios). */\n    getTwilioSandboxInfo: () => request(\"/admin/twilio/sandbox-info\", {\n      auth: true\n    }),\n    // ===== MARKETING — Cupones de descuento =====\n    /** Crea un cupón. Si `codigo` se omite, genera uno automático tipo PRO-X9K2A7. */\n    crearCupon: body => request(\"/admin/cupones\", {\n      method: \"POST\",\n      body,\n      auth: true\n    }),\n    /** Lista cupones del organizador (filtros opc.). */\n    listarCupones: params => {\n      const qs = new URLSearchParams();\n      if (params?.reta_id) qs.set(\"reta_id\", params.reta_id);\n      if (params?.solo_disponibles) qs.set(\"solo_disponibles\", \"true\");\n      const url = `/admin/cupones${qs.toString() ? `?${qs.toString()}` : \"\"}`;\n      return request(url, {\n        auth: true\n      });\n    },\n    borrarCupon: cuponId => request(`/admin/cupones/${cuponId}`, {\n      method: \"DELETE\",\n      auth: true\n    }),\n    reactivarCupon: cuponId => request(`/admin/cupones/${cuponId}/reactivar`, {\n      method: \"POST\",\n      auth: true\n    }),\n    /** Pre-validación del cupón antes del canje (no consume). PÚBLICO. */\n    validarCupon: (retaId, codigo) => request(`/public/retas/${retaId}/cupon/validar`, {\n      method: \"POST\",\n      body: {\n        codigo\n      }\n    }),\n    /** Canje ATÓMICO. PÚBLICO. Crea inscripción Aprobada al instante. */\n    canjearCupon: (retaId, body) => request(`/public/retas/${retaId}/cupon/canjear`, {\n      method: \"POST\",\n      body\n    }),\n    /** Cancela inscripción INDIVIDUAL (reactiva cupón si aplica). Admin auth. */\n    cancelarInscripcionCuponAware: inscId => request(`/admin/inscripciones/${inscId}/cancelar`, {\n      method: \"DELETE\",\n      auth: true\n    }),\n    // ===== Deploy readiness (LIVE checklist) =====\n    /** Verifica el estado de las credenciales productivas antes de publicar. */\n    getDeployReadiness: () => request(\"/admin/deploy-readiness\", {\n      auth: true\n    }),\n    // ===== RSVP — Retas Gratis / Entre Amigos =====\n    rsvpAceptar: (retaId, body) => request(`/public/retas/${retaId}/rsvp/aceptar`, {\n      method: \"POST\",\n      body\n    }),\n    rsvpRechazar: (retaId, body) => request(`/public/retas/${retaId}/rsvp/rechazar`, {\n      method: \"POST\",\n      body\n    }),\n    /** Vista admin agrupada por estatus de confirmación. */\n    getAsistencia: retaId => request(`/admin/retas/${retaId}/asistencia`, {\n      auth: true\n    }),\n    /** Cambia el estatus_confirmacion de una inscripción (admin). */\n    setEstatusInscripcion: (inscId, estatus) => request(`/admin/inscripciones/${inscId}/estatus`, {\n      method: \"PATCH\",\n      body: {\n        estatus_confirmacion: estatus\n      },\n      auth: true\n    })\n  };\n\n  /**\n   * Helper privado: descarga un blob autenticado y devuelve un blob URL listo\n   * para abrir/descargar desde el browser.\n   */\n  async function _downloadBlob(path, expectedMime) {\n    const headers = {};\n    Object.assign(headers, await tokenHeader());\n    const res = await fetch(`${BASE}/api${path}`, {\n      method: \"GET\",\n      headers\n    });\n    if (!res.ok) {\n      let detail = \"\";\n      try {\n        detail = (await res.text()).slice(0, 200);\n      } catch {\n        /* noop */\n      }\n      throw new Error(`Descarga error ${res.status}: ${detail}`);\n    }\n    const blob = await res.blob();\n    // Forzar el MIME esperado si el browser lo perdió\n    const typedBlob = blob.type ? blob : new Blob([blob], {\n      type: expectedMime\n    });\n    return URL.createObjectURL(typedBlob);\n  }\n});","lineCount":859,"map":[[12,2,26,0,"exports"],[12,9,26,0],[12,10,26,0,"onAuthExpired"],[12,23,26,0],[12,26,26,0,"onAuthExpired"],[12,39,26,0],[13,2,345,0,"exports"],[13,9,345,0],[13,10,345,0,"getAdminAccessToken"],[13,29,345,0],[13,32,345,0,"getAdminAccessToken"],[13,51,345,0],[14,2,350,0,"exports"],[14,9,350,0],[14,10,350,0,"backendBaseUrl"],[14,24,350,0],[14,27,350,0,"backendBaseUrl"],[14,41,350,0],[15,2,367,0,"exports"],[15,9,367,0],[15,10,367,0,"getRefreshToken"],[15,25,367,0],[15,28,367,0,"getRefreshToken"],[15,43,367,0],[16,2,372,0,"exports"],[16,9,372,0],[16,10,372,0,"setRefreshToken"],[16,25,372,0],[16,28,372,0,"setRefreshToken"],[16,43,372,0],[17,2,482,0,"Object"],[17,8,482,0],[17,9,482,0,"defineProperty"],[17,23,482,0],[17,24,482,0,"exports"],[17,31,482,0],[18,4,482,0,"enumerable"],[18,14,482,0],[19,4,482,0,"get"],[19,7,482,0],[19,18,482,0,"get"],[19,19,482,0],[20,6,482,0],[20,13,482,0,"api"],[20,16,482,0],[21,4,482,0],[22,2,482,0],[23,2,1319,2],[23,6,1319,2,"_expoVirtualEnv"],[23,21,1319,2],[23,24,1319,2,"require"],[23,31,1319,2],[23,32,1319,2,"_dependencyMap"],[23,46,1319,2],[24,2,1319,2],[24,6,1319,2,"_reactNativeWebDistExportsPlatform"],[24,40,1319,2],[24,43,1319,2,"require"],[24,50,1319,2],[24,51,1319,2,"_dependencyMap"],[24,65,1319,2],[25,2,1319,2],[25,6,1319,2,"Platform"],[25,14,1319,2],[25,17,1319,2,"_interopDefault"],[25,32,1319,2],[25,33,1319,2,"_reactNativeWebDistExportsPlatform"],[25,67,1319,2],[