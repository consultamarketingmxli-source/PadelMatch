 = await request(\"/auth/login\", {\n        method: \"POST\",\n        body: {\n          username,\n          password\n        }\n      });\n      await _srcUtilsStorage.storage.secureSet(TOKEN_KEY, r.access_token);\n      return r;\n    },\n    async logout() {\n      await _srcUtilsStorage.storage.secureRemove(TOKEN_KEY);\n    },\n    async getToken() {\n      return (await _srcUtilsStorage.storage.secureGet(TOKEN_KEY, \"\")) || null;\n    },\n    async me() {\n      return request(\"/auth/me\", {\n        auth: true\n      });\n    },\n    // ===== retas admin =====\n    listRetasAdmin: () => request(\"/retas\", {\n      auth: true\n    }),\n    getRetaAdmin: id => request(`/retas/${id}`, {\n      auth: true\n    }),\n    createReta: body => request(\"/retas\", {\n      method: \"POST\",\n      body,\n      auth: true\n    }),\n    updateReta: (id, body) => request(`/retas/${id}`, {\n      method: \"PUT\",\n      body,\n      auth: true\n    }),\n    deleteReta: id => request(`/retas/${id}`, {\n      method: \"DELETE\",\n      auth: true\n    }),\n    listInscripciones: id => request(`/retas/${id}/inscripciones`, {\n      auth: true\n    }),\n    // ===== Compartir (Fase B) =====\n    getShareInfo: id => request(`/retas/${id}/share-info`, {\n      auth: true\n    }),\n    /** URL absoluta del PNG QR público (no requiere auth) — sirve como src de <Image>. */\n    getPublicQrUrl: slug => `${BASE}/api/public/retas/${slug}/qr`,\n    // ===== retas público =====\n    radar: (lat, lng, radioKm = 30) => {\n      const qs = lat !== undefined && lng !== undefined ? `?lat=${lat}&lng=${lng}&radio_km=${radioKm}` : \"\";\n      return request(`/public/retas/radar${qs}`);\n    },\n    /**\n     * Motor de búsqueda híbrido — 3 vías combinables:\n     *  A) GPS (lat/lng + radioKm)\n     *  B) Texto (q, trim+lowercase aplicado en server)\n     *  C) Fallback: sin params → todas ordenadas por fecha_evento ASC.\n     */\n    buscarRetas: params => {\n      const sp = new URLSearchParams();\n      const q = (params.q ?? \"\").trim().toLowerCase();\n      if (q) sp.set(\"q\", q);\n      if (params.lat !== undefined && params.lng !== undefined) {\n        sp.set(\"lat\", String(params.lat));\n        sp.set(\"lng\", String(params.lng));\n        sp.set(\"radio_km\", String(params.radioKm ?? 30));\n      }\n      const qs = sp.toString() ? `?${sp.toString()}` : \"\";\n      return request(`/public/retas/buscar${qs}`);\n    },\n    getRetaBySlug: slug => request(`/public/retas/${slug}`),\n    // ===== inscripciones =====\n    checkout: (retaId, body) => request(`/public/retas/${retaId}/checkout`, {\n      method: \"POST\",\n      body\n    }),\n    joinWaitlist: (retaId, body) => request(`/public/retas/${retaId}/waitlist`, {\n      method: \"POST\",\n      body\n    }),\n    paymentWebhook: (inscripcionId, status) => request(`/webhooks/payment`, {\n      method: \"POST\",\n      body: {\n        inscripcion_id: inscripcionId,\n        status\n      }\n    }),\n    // ===== stats =====\n    playerStats: telefono => request(`/public/players/${encodeURIComponent(telefono)}/stats`),\n    // ===== resultados =====\n    getRol: retaId => request(`/retas/${retaId}/rol`, {\n      auth: true\n    }),\n    /**\n     * Persiste el orden manual de jugadores (drag & drop entre canchas).\n     * Body: lista ordenada de nombres — debe coincidir 1:1 con inscritos aprobados.\n     * Reglas: 409 si ya existen resultados capturados; 422 si nombres no coinciden.\n     */\n    updateJugadoresOrden: (retaId, jugadores) => request(`/retas/${retaId}/jugadores/orden`, {\n      method: \"PUT\",\n      body: {\n        jugadores\n      },\n      auth: true\n    }),\n    /**\n     * Preview del rol Round Robin con un orden tentativo de jugadores.\n     * No persiste nada — solo simula. Usado en UX de drag & drop para\n     * que el organizador vea cómo quedará la distribución de partidos.\n     */\n    previewRol: (retaId, jugadores) => request(`/retas/${retaId}/rol/preview`, {\n      method: \"POST\",\n      body: {\n        jugadores\n      },\n      auth: true\n    }),\n    /**\n     * Importación masiva de jugadores (CSV). El backend valida cupo,\n     * duplicados y bloquea si ya hay resultados (409).\n     * Devuelve breakdown: creadas + omitidos[{nombre, razon}].\n     */\n    importInscripciones: (retaId, jugadores) => request(`/retas/${retaId}/inscripciones/import`, {\n      method: \"POST\",\n      body: {\n        jugadores\n      },\n      auth: true\n    }),\n    listResultados: retaId => request(`/retas/${retaId}/resultados`, {\n      auth: true\n    }),\n    upsertResultado: (retaId, body) => request(`/retas/${retaId}/resultados`, {\n      method: \"POST\",\n      body,\n      auth: true\n    }),\n    deleteResultado: (retaId, resultId) => request(`/retas/${retaId}/resultados/${resultId}`, {\n      method: \"DELETE\",\n      auth: true\n    }),\n    tablaPosiciones: retaId => request(`/public/retas/${retaId}/tabla`),\n    /** Clasificación privada — admin (auth:true) o player (header Authorization). */\n    getClasificacionAdmin: retaId => request(`/retas/${retaId}/clasificacion`, {\n      auth: true\n    }),\n    getClasificacionPlayer: (retaId, playerToken) => request(`/retas/${retaId}/clasificacion`, {\n      headers: {\n        Authorization: `Bearer ${playerToken}`\n      }\n    }),\n    /** URL completa del WebSocket realtime. token opcional (admin o player). */\n    getRealtimeWsUrl: (retaId, token) => {\n      const httpBase = (BASE || \"\").replace(/\\/$/, \"\");\n      const wsBase = httpBase.replace(/^http:/, \"ws:\").replace(/^https:/, \"wss:\");\n      const encoded = encodeURIComponent(token);\n      return `${wsBase}/api/ws/retas/${encodeURIComponent(retaId)}?token=${encoded}`;\n    },\n    // ===== stripe checkout =====\n    checkoutStripe: (retaId, body) => request(`/public/retas/${retaId}/checkout-stripe`, {\n      method: \"POST\",\n      body\n    }),\n    paymentStatus: inscripcionId => request(`/