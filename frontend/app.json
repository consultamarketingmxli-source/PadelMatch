{
  "expo": {
    "name": "PadelAppRetas",
    "slug": "padelappretas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "padelappretas",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/images/icon.png",
        "tinted": "./assets/images/icon-monochrome.png"
      },
      "bundleIdentifier": "com.padelappretas.app",
      "associatedDomains": [
        "applinks:padelappretas.app",
        "applinks:www.padelappretas.app"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Para mostrarte retas cercanas a tu ubicación",
        "NSUserNotificationsUsageDescription": "Te avisamos al instante cuando se libere tu cupo",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/icon-monochrome.png",
        "backgroundColor": "#101830"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.padelappretas.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "padelappretas.app",
              "pathPrefix": "/retas/"
            },
            {
              "scheme": "https",
              "host": "www.padelappretas.app",
              "pathPrefix": "/retas/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon-monochrome.png",
          "color": "#2563EB",
          "defaultChannel": "default"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "padelappretas",
          "project": "padelappretas-mobile",
          "url": "https://sentry.io/"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5641434677902126~1440922796",
          "userTrackingPermission": "Permíteme mostrarte anuncios relevantes para apoyar PadelAppRetas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
